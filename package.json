{
  "name": "mushroomscope",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/validate-content.mjs && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "queue:publish": "node scripts/publish-queue.mjs",
    "library:generate": "node scripts/generate-content-library.mjs",
    "library:audit": "node scripts/audit-content-library.mjs",
    "species:generate": "node scripts/generate-species-expansion.mjs",
    "species:audit": "node scripts/audit-species-expansion.mjs",
    "audit:gsc-indexing": "node scripts/audit-google-indexing.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "^5.9.3"
  }
}
