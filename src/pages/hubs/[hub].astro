---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { entryDisplayDate, entryPath, getPublishedEntries } from '../../lib/content';
import { hubDefinitions } from '../../lib/hubs';

export function getStaticPaths() {
  return Object.keys(hubDefinitions).map((hub) => ({ params: { hub }, props: { hub: hubDefinitions[hub as keyof typeof hubDefinitions] } }));
}

const { hub } = Astro.props;
const published = await getPublishedEntries();
type PublishedEntry = (typeof published)[number];
const isPublishedEntry = (entry: PublishedEntry | undefined): entry is PublishedEntry => Boolean(entry);
const articleByKey = new Map(published.map((entry) => [`${entry.data.category}/${entry.id}`, entry]));
const primaryArticles = hub.primary.map((key) => articleByKey.get(key)).filter(isPublishedEntry);
const fallbackArticles = published
  .filter((entry) => hub.categories.includes(entry.data.category as never))
  .filter((entry) => !hub.primary.includes(`${entry.data.category}/${entry.id}` as never))
  .slice(0, Math.max(0, 9 - primaryArticles.length));
const articles = [...primaryArticles, ...fallbackArticles].slice(0, 9);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${canonical}#collection`,
    name: hub.title,
    description: hub.description,
    url: canonical,
    isPartOf: { '@id': 'https://mushroomscope.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: entry.data.title,
        url: new URL(entryPath(entry), Astro.site).href,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mushroomscope.com/' },
      { '@type': 'ListItem', position: 2, name: hub.title, item: canonical },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: hub.questions.map((question) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: hub.description },
    })),
  },
];
---
<BaseLayout title={hub.title} seoTitle={hub.seoTitle} description={hub.description} schema={schema}>
  <div class="shell py-8"><Breadcrumbs items={[{ label: hub.title }]} /></div>
  <header class="shell py-12 sm:py-16">
    <p class="eyebrow">{hub.eyebrow}</p>
    <h1 class="mt-4 max-w-4xl font-serif text-5xl sm:text-6xl">{hub.title}</h1>
    <p class="mt-6 max-w-3xl text-xl leading-8 text-slate-600">{hub.intro}</p>
  </header>
  <section class="shell pb-12" aria-labelledby="hub-questions">
    <div class="grid gap-5 lg:grid-cols-3">
      {hub.questions.map((question) => <article class="card"><p class="eyebrow">Reader question</p><h2 class="mt-3 font-serif text-2xl">{question}</h2><p class="mt-3 leading-7 text-slate-600">{hub.description}</p></article>)}
    </div>
    <aside class="mt-6 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm leading-6 text-amber-950"><strong>Important limit:</strong> {hub.safety}</aside>
  </section>
  <section class="shell py-12" aria-labelledby="hub-guides">
    <p class="eyebrow">Recommended path</p>
    <h2 id="hub-guides" class="mt-3 font-serif text-4xl">Guides in this cluster</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((entry) => <ArticleCard title={entry.data.title} description={entry.data.description} category={entry.data.category} date={entryDisplayDate(entry)} href={entryPath(entry)} image={entry.data.coverImage} imageAlt={entry.data.coverAlt} />)}
    </div>
  </section>
</BaseLayout>
