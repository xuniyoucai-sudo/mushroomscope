---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdBanner from '../../components/AdBanner.astro';
import { entryPath, getPublishedEntries } from '../../lib/content';
export function getStaticPaths() {
  const details: Record<string, { title: string; description: string; intro: string }> = {
    mushrooms: { title: 'Mushroom Encyclopedia', description: 'Explore mushroom species, defining characteristics, habitats, seasons, uses, and notable lookalikes.', intro: 'A growing, carefully organized reference to the diverse fungi found around the world.' },
    identification: { title: 'Mushroom Identification Guides', description: 'Learn how to observe cap, gill, stem, spore, habitat, and seasonal features responsibly.', intro: 'Build methodical identification skills with practical, safety-first field guides.' },
    growing: { title: 'Grow Mushrooms at Home', description: 'Learn mushroom cultivation with clear tutorials for beginners and experienced home growers.', intro: 'From clean technique and substrate choice to fruiting conditions and harvest.' },
    health: { title: 'Mushrooms & Health', description: 'Explore evidence-aware guides to mushroom nutrition, traditional use, and current research.', intro: 'Clear context for curious readers—not medical advice or miracle claims.' },
    recipes: { title: 'Mushroom Recipes', description: 'Discover satisfying mushroom recipes, cooking techniques, flavor pairings, and kitchen tips.', intro: 'Bring out the texture, aroma, and umami of cultivated edible mushrooms.' }
  };
  return Object.keys(details).map(category => ({ params: { category }, props: { detail: details[category] } }));
}
const { category } = Astro.params;
const { detail } = Astro.props;
const articles = (await getPublishedEntries()).filter(({ data }) => data.category === category);
const speciesArticles = category === 'mushrooms' ? articles.map((article) => ({ article, data: article.data as typeof article.data & { scientificName?: string; taxonomy?: { genus: string; family?: string } } })) : [];
const alphabet = [...new Set(speciesArticles.map(({ data }) => (data.scientificName ?? data.title).charAt(0).toUpperCase()))].sort();
const genera = [...new Set(speciesArticles.map(({ data }) => data.taxonomy?.genus).filter((value): value is string => Boolean(value)))].sort();
const families = [...new Set(speciesArticles.map(({ data }) => data.taxonomy?.family).filter((value): value is string => Boolean(value)))].sort();
const breadcrumbSchema = [
  { '@type': 'CollectionPage', '@id': `https://mushroomscope.com/${category}/#collection`, name: detail.title, description: detail.description, url: `https://mushroomscope.com/${category}/`, isPartOf: { '@id': 'https://mushroomscope.com/#website' }, mainEntity: { '@type': 'ItemList', numberOfItems: articles.length, itemListElement: articles.map((article, index) => ({ '@type': 'ListItem', position: index + 1, url: new URL(entryPath(article), Astro.site).href, name: article.data.title })) } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mushroomscope.com/' }, { '@type': 'ListItem', position: 2, name: detail.title }] }
];
const cardMeta = (article: (typeof articles)[number]) => {
  const data = article.data as typeof article.data & { scientificName?: string; difficulty?: string; targetSpecies?: string[]; mushroomSpecies?: string[]; evidenceLevel?: string; recipe?: { totalTime?: string; prepTime: string; cookTime: string } };
  if (data.scientificName) return data.scientificName;
  if (data.difficulty) return `${data.difficulty} · ${data.targetSpecies?.slice(0, 2).join(', ') || 'cultivation guide'}`;
  if (data.recipe) return `${data.recipe.totalTime || `${data.recipe.prepTime} + ${data.recipe.cookTime}`} · ${data.mushroomSpecies?.slice(0, 2).join(', ') || 'cultivated mushrooms'}`;
  if (data.evidenceLevel) return `${data.evidenceLevel} evidence · editorial review`;
  return undefined;
};
---
<BaseLayout title={detail.title} description={detail.description} noindex={articles.length === 0} schema={breadcrumbSchema}>
  <div class="shell py-8"><Breadcrumbs items={[{ label: detail.title }]} /></div>
  <header class="shell py-12 sm:py-16"><p class="eyebrow">MushroomScope library</p><h1 class="mt-4 max-w-4xl font-serif text-5xl sm:text-6xl">{detail.title}</h1><p class="mt-6 max-w-3xl text-xl leading-8 text-slate-600">{detail.intro}</p></header>
  <div class="shell"><AdBanner /></div>
  {speciesArticles.length > 0 && <nav class="shell pt-10" aria-label="Browse species"><div class="card"><h2 class="font-serif text-2xl">Browse the encyclopedia</h2><div class="mt-5 grid gap-6 lg:grid-cols-3"><div><p class="eyebrow">Scientific name A–Z</p><div class="mt-3 flex flex-wrap gap-2">{alphabet.map((letter) => <a class="grid size-9 place-items-center rounded-full border border-beige-300 no-underline hover:bg-sage-100" href={`#letter-${letter.toLowerCase()}`}>{letter}</a>)}</div></div><div><p class="eyebrow">Genera</p><div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">{genera.map((genus) => <a href={`/mushrooms/genus/${genus.toLowerCase()}/`}><em>{genus}</em></a>)}</div></div><div><p class="eyebrow">Families</p><div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">{families.map((family) => <a href={`/mushrooms/family/${family.toLowerCase()}/`}>{family}</a>)}</div></div></div>{speciesArticles.length >= 8 && <form id="species-filter" class="mt-7 grid gap-3 border-t border-beige-300 pt-6 sm:grid-cols-2" role="search"><label class="grid gap-2 text-sm font-semibold">Filter by genus<select id="filter-genus" class="min-h-11 rounded-xl border border-beige-300 bg-white px-3"><option value="">All genera</option>{genera.map((genus) => <option value={genus.toLowerCase()}>{genus}</option>)}</select></label><label class="grid gap-2 text-sm font-semibold">Filter by family<select id="filter-family" class="min-h-11 rounded-xl border border-beige-300 bg-white px-3"><option value="">All families</option>{families.map((family) => <option value={family.toLowerCase()}>{family}</option>)}</select></label><p id="species-filter-status" class="text-sm text-slate-600 sm:col-span-2" aria-live="polite">Showing all {speciesArticles.length} published species.</p></form>}</div></nav>}
  {speciesArticles.length > 0 && <section class="shell pt-10" aria-labelledby="taxonomy-index"><h2 id="taxonomy-index" class="font-serif text-3xl">Species index</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{speciesArticles.sort((a, b) => (a.data.scientificName ?? a.data.title).localeCompare(b.data.scientificName ?? b.data.title)).map(({ article, data }, index, sorted) => {
    const initial = (data.scientificName ?? data.title).charAt(0).toLowerCase();
    const isFirstInitial = sorted.findIndex(({ data: candidate }) => (candidate.scientificName ?? candidate.title).charAt(0).toLowerCase() === initial) === index;
    const isFirstGenus = Boolean(data.taxonomy?.genus) && sorted.findIndex(({ data: candidate }) => candidate.taxonomy?.genus === data.taxonomy?.genus) === index;
    const isFirstFamily = Boolean(data.taxonomy?.family) && sorted.findIndex(({ data: candidate }) => candidate.taxonomy?.family === data.taxonomy?.family) === index;
    return <a href={entryPath(article)} class="species-index-card article-card-link group block rounded-2xl no-underline" id={isFirstInitial ? `letter-${initial}` : undefined} data-genus={data.taxonomy?.genus?.toLowerCase()} data-family={data.taxonomy?.family?.toLowerCase()} aria-label={`Read ${article.data.title}`}><article class="h-full rounded-2xl border border-beige-300 bg-white p-5 transition duration-200 group-hover:-translate-y-1 group-hover:border-forest-700/40 group-hover:shadow-lg"><span id={isFirstGenus ? `genus-${data.taxonomy?.genus.toLowerCase()}` : undefined}></span><span id={isFirstFamily ? `family-${data.taxonomy?.family?.toLowerCase()}` : undefined}></span><h3 class="font-serif text-xl transition group-hover:text-forest-700"><em>{data.scientificName}</em></h3><p class="mt-2 text-sm text-slate-600">{data.taxonomy?.family} · {article.data.title}</p><p class="mt-3 text-xs text-slate-500">{(data as any).habitat?.regions?.slice(0, 3).join(' · ')}</p></article></a>;
  })}</div></section>}
  {category !== 'mushrooms' && <section class="shell py-16">{articles.length ? <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <ArticleCard title={article.data.title} description={article.data.description} category={article.data.category} date={article.data.publishDate} href={entryPath(article)} image={article.data.coverImage} imageAlt={article.data.coverAlt} meta={cardMeta(article)} />)}</div> : <div class="card py-16 text-center"><p class="font-serif text-3xl">Guides are in editorial review</p><p class="mx-auto mt-3 max-w-xl text-slate-600">New {category} material is published after source and safety checks.</p></div>}</section>}
  {category === 'mushrooms' && <div class="pb-16"></div>}
  {category === 'mushrooms' && <script>
    const genus = document.querySelector<HTMLSelectElement>('#filter-genus');
    const family = document.querySelector<HTMLSelectElement>('#filter-family');
    const cards = [...document.querySelectorAll<HTMLElement>('.species-index-card')];
    const status = document.querySelector<HTMLElement>('#species-filter-status');
    const apply = () => {
      let visible = 0;
      cards.forEach((card) => { const show = (!genus?.value || card.dataset.genus === genus.value) && (!family?.value || card.dataset.family === family.value); card.hidden = !show; if (show) visible += 1; });
      if (status) status.textContent = `Showing ${visible} published species.`;
    };
    genus?.addEventListener('change', apply); family?.addEventListener('change', apply);
  </script>}
</BaseLayout>
