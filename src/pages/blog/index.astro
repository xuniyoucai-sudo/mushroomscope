---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { entryPath, getPublishedEntries } from '../../lib/content';
const articles = await getPublishedEntries();
---
<BaseLayout title="Mushroom Blog" description="Read the latest MushroomScope guides about mushroom species, identification, cultivation, health, and cooking." noindex={articles.length === 0}><div class="shell py-8"><Breadcrumbs items={[{ label: 'Blog' }]} /></div><header class="shell py-12"><p class="eyebrow">The journal</p><h1 class="mt-4 font-serif text-5xl sm:text-6xl">Latest mushroom guides</h1><p class="mt-5 max-w-3xl text-xl leading-8 text-slate-600">Thoughtful, practical reading for curious mushroom people.</p></header><section class="shell py-10">{articles.length ? <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{articles.map(a => <ArticleCard title={a.data.title} description={a.data.description} category={a.data.category} date={a.data.publishDate} href={entryPath(a)} />)}</div> : <div class="card py-16 text-center"><p class="font-serif text-3xl">No articles published yet</p><p class="mt-3 text-slate-600">The content system is ready for the first field guide.</p></div>}</section></BaseLayout>
