---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="Contact" description="Contact the MushroomScope editorial team with feedback, corrections, or partnership inquiries."><div class="shell py-8"><Breadcrumbs items={[{label:'Contact'}]} /></div><section class="shell max-w-4xl py-12"><p class="eyebrow">Get in touch</p><h1 class="mt-4 font-serif text-5xl sm:text-6xl">Contact MushroomScope</h1><p class="mt-6 text-xl leading-8 text-slate-600">For editorial feedback, corrections, or partnership inquiries, email <!--email_off--><a class="font-semibold text-forest-700" href="mailto:hello@mushroomscope.com">hello@mushroomscope.com</a><!--/email_off-->.</p><div class="card mt-10"><p class="font-bold">Identification safety</p><p class="mt-2 leading-7 text-slate-600">We cannot confirm whether a mushroom is safe to eat by email. Contact a local mycological society or poison control service for urgent help.</p></div></section></BaseLayout>
