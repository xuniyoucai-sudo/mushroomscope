---
import { render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { entryKey, getPublishedEntries } from '../lib/content';
export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  return entries.map(entry => ({ params: { slug: entryKey(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout {...entry.data} currentKey={entryKey(entry)} headings={headings}><Content /></ArticleLayout>
