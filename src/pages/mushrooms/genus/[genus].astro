---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { entryPath, getIndexableTaxa, getPublishedEntries } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = (await getPublishedEntries()).filter(({ data }) => data.category === 'mushrooms');
  const genera = getIndexableTaxa(entries as any, 'genus').map(([genus]) => genus);
  return genera.map((genus) => ({ params: { genus: genus.toLowerCase() }, props: { genus, entries: entries.filter(({ data }) => (data as any).taxonomy?.genus === genus) } }));
}
const { genus, entries } = Astro.props;
const title = `${genus} Mushroom Species`;
const description = `Browse published MushroomScope profiles for species in the genus ${genus}, including identification, habitat, safety context, and cultivation links.`;
const schema = { '@type': 'CollectionPage', name: title, description, url: Astro.url.href, mainEntity: { '@type': 'ItemList', numberOfItems: entries.length, itemListElement: entries.map((entry: any, index: number) => ({ '@type': 'ListItem', position: index + 1, name: entry.data.scientificName, url: new URL(entryPath(entry), Astro.site).href })) } };
---
<BaseLayout title={title} description={description} schema={schema}>
  <div class="shell py-8"><Breadcrumbs items={[{ label: 'Mushroom Encyclopedia', href: '/mushrooms/' }, { label: `Genus ${genus}` }]} /></div>
  <header class="shell py-12"><p class="eyebrow">Taxonomic index · genus</p><h1 class="mt-4 font-serif text-5xl sm:text-6xl"><em>{genus}</em></h1><p class="mt-5 max-w-3xl text-xl leading-8 text-slate-600">{description}</p></header>
  <section class="shell pb-20"><div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{entries.map((entry: any) => <ArticleCard title={entry.data.title} description={entry.data.description} category="Species" href={entryPath(entry)} image={entry.data.coverImage} imageAlt={entry.data.coverAlt} meta={entry.data.scientificName} />)}</div></section>
</BaseLayout>
