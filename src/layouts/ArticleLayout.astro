---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdBanner from '../components/AdBanner.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { entryKey, entryPath, getIndexableTaxa, getPublishedEntries, taxonPath } from '../lib/content';

interface FAQItem { question: string; answer: string }
interface SourceItem { title: string; url: string }
interface RecipeData { prepTime: string; cookTime: string; totalTime?: string; recipeYield: string; recipeCategory: string; recipeCuisine?: string; ingredients: string[]; instructions: string[]; calories?: string }
interface Taxonomy { kingdom?: string; phylum?: string; class?: string; order?: string; family?: string; genus: string }
interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  keywords?: string[];
  category: string;
  author: string;
  publishDate: Date;
  updatedDate?: Date;
  revisionSummary?: string;
  coverImage?: ImageMetadata;
  coverAlt?: string;
  imageCredit?: string;
  imageNote?: string;
  relatedEntries?: string[];
  faq?: FAQItem[];
  sources?: SourceItem[];
  recipe?: RecipeData;
  currentKey: string;
  scientificName?: string;
  taxonomicAuthority?: string;
  synonyms?: string[];
  externalIds?: { ncbi?: string; gbif?: string; indexFungorum?: string };
  commonNames?: string[];
  taxonomy?: Taxonomy;
  habitat?: { summary: string; regions: string[]; substrates: string[] };
  season?: { summary: string; months: string[] };
  edibility?: { status: string; notes: string };
  toxicity?: { level: string; notes: string };
  growingDifficulty?: { level: string; notes: string };
  appearance?: { sporePrint: string };
  reviewedBy?: string;
  evidenceLevel?: 'established' | 'moderate' | 'preliminary' | 'insufficient';
  reviewStatus?: 'editorial' | 'expert-reviewed';
  reviewDate?: Date;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title, seoTitle, description, keywords = [], category, author, publishDate, updatedDate, revisionSummary, coverImage, coverAlt, imageCredit, imageNote,
  faq: editorialFaq = [], sources = [], recipe, currentKey, scientificName, commonNames = [], taxonomy,
  habitat, season, edibility, toxicity, growingDifficulty, appearance, reviewedBy,
  taxonomicAuthority, synonyms = [], externalIds, relatedEntries = [], headings = [], evidenceLevel, reviewStatus, reviewDate,
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const categoryNames: Record<string, string> = {
  mushrooms: 'Mushroom Encyclopedia', identification: 'Identification', growing: 'Growing', health: 'Health', recipes: 'Recipes',
};
const categoryName = categoryNames[category] ?? category;
const formatValue = (value?: string) => value ? value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) : 'Not documented';

const automaticFaq: Record<string, FAQItem[]> = {
  mushrooms: [
    { question: `What is covered in this ${title} species guide?`, answer: description },
    { question: 'Can this page confirm whether a wild mushroom is safe to eat?', answer: 'No. Online text and photographs cannot replace examination of the complete specimen by a qualified local expert. Never eat a wild mushroom unless its identity and edibility have been confirmed in person.' },
    { question: 'Why can this mushroom look different from the description?', answer: 'Age, weather, substrate, geographic variation, strain, and cultivation conditions can change color, size, texture, and growth form. Identification must use multiple characters rather than one photograph or feature.' },
  ],
  identification: [
    { question: `What will I learn from ${title}?`, answer: description },
    { question: 'Is a photograph enough to identify a mushroom?', answer: 'No. Reliable identification also considers the underside, stem base, substrate, habitat, spore deposit, odor, developmental stage, location, and sometimes microscopic or DNA evidence.' },
    { question: 'Can an identification guide determine whether a mushroom is edible?', answer: 'A guide can help organize observations, but it cannot confirm edibility remotely. Consumption decisions require in-person confirmation from a qualified local expert.' },
  ],
  growing: [
    { question: `What does this ${title} growing guide cover?`, answer: description },
    { question: 'Should beginners use commercial mushroom spawn?', answer: 'Yes. Authenticated spawn or a reputable ready-to-fruit block is safer and more predictable than cloning an unidentified wild mushroom.' },
    { question: 'What should I do if a growing block develops unusual mold or odor?', answer: 'Isolate it from other cultures and do not eat anything from it. Follow the supplier’s disposal guidance; unexplained colors, slime, or foul odors should be treated as contamination.' },
  ],
  recipes: [
    { question: `What does this ${title} recipe include?`, answer: description },
    { question: 'Can I use a wild mushroom in this recipe?', answer: 'Only use mushrooms sold as food by a reputable supplier. A recipe is not an identification guide, and cooking does not make a poisonous mushroom safe.' },
    { question: 'How should mushroom recipe leftovers be stored?', answer: 'Cool and refrigerate leftovers promptly in a clean covered container, follow local food-safety guidance, and discard food that shows spoilage or has been held unsafely.' },
  ],
  health: [
    { question: `What evidence does ${title} discuss?`, answer: description },
    { question: 'Is mushroom research the same as proof of a medical benefit?', answer: 'No. Cell, animal, observational, and small clinical studies have different limitations. A claim requires high-quality human evidence for the same species, preparation, dose, and health outcome.' },
    { question: 'Can mushroom foods or supplements replace medical treatment?', answer: 'No. Do not delay diagnosis or replace prescribed care with a mushroom product. Discuss supplements with a qualified clinician, especially when taking medication or receiving treatment.' },
  ],
};
const faq = editorialFaq.length > 0 ? editorialFaq : automaticFaq[category] ?? [
  { question: `What is ${title} about?`, answer: description },
  { question: 'How should this guide be used?', answer: 'Use it as general educational information and verify decisions involving identification, food safety, cultivation, or health with an appropriate qualified expert.' },
];

const normalizeTerms = (values: string[]) => new Set(values.flatMap((value) => value.toLowerCase().split(/[^a-z]+/)).filter((value) => value.length > 3));
const currentTerms = normalizeTerms([title, scientificName ?? '', ...commonNames]);
const allPublished = await getPublishedEntries();
const speciesEntries = allPublished.filter((entry) => entry.data.category === 'mushrooms');
const indexableGenera = new Set(getIndexableTaxa(speciesEntries as any, 'genus').map(([name]) => name));
const indexableFamilies = new Set(getIndexableTaxa(speciesEntries as any, 'family').map(([name]) => name));
const explicitRelated = relatedEntries
  .map((key) => allPublished.find((entry) => entryKey(entry) === key))
  .filter((entry): entry is (typeof allPublished)[number] => Boolean(entry));
const automaticRelated = allPublished
  .filter((entry) => entryKey(entry) !== currentKey)
  .filter((entry) => !relatedEntries.includes(entryKey(entry)))
  .map((entry) => {
    const data = entry.data as typeof entry.data & { scientificName?: string; commonNames?: string[]; taxonomy?: Taxonomy };
    const terms = normalizeTerms([data.title, data.scientificName ?? '', ...(data.commonNames ?? []), ...data.keywords]);
    const sharedTerms = [...currentTerms].filter((term) => terms.has(term)).length;
    const sameGenus = Boolean(taxonomy?.genus && data.taxonomy?.genus === taxonomy.genus);
    const sameFamily = Boolean(taxonomy?.family && data.taxonomy?.family === taxonomy.family);
    return { entry, score: sharedTerms * 2 + (data.category === category ? 3 : 0) + (sameFamily ? 4 : 0) + (sameGenus ? 8 : 0) };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || a.entry.data.title.localeCompare(b.entry.data.title))
  .slice(0, Math.max(0, 3 - explicitRelated.length))
  .map(({ entry }) => entry);
const related = [...explicitRelated, ...automaticRelated].slice(0, 3);
const trustNotes: Record<string, { label: string; title: string; text: string; href: string; link: string }[]> = {
  identification: [
    { label: 'Safety first', title: 'Use as a field-record guide', text: 'Document the whole mushroom, habitat, substrate, and region before comparing names or photographs.', href: '/hubs/mushroom-identification-safety/', link: 'Open the identification safety hub' },
    { label: 'Decision limit', title: 'Do not use this as an edibility verdict', text: 'Wild mushroom consumption decisions require qualified local, in-person confirmation of the complete specimen.', href: '/disclaimer/', link: 'Read the safety disclaimer' },
  ],
  mushrooms: [
    { label: 'Species context', title: 'Treat profiles as reference material', text: 'Species profiles summarize documented traits, taxonomy, and lookalikes, but natural variation can be substantial.', href: '/identification/mushroom-identification-safety-checklist/', link: 'Use the safety checklist' },
    { label: 'Decision limit', title: 'A profile cannot authenticate a specimen', text: 'Do not eat a wild mushroom from an online match, single feature, or generated image.', href: '/disclaimer/', link: 'Read the safety disclaimer' },
  ],
  health: [
    { label: 'Evidence context', title: 'Food, extracts, and supplements differ', text: 'Health conclusions depend on species, fungal part, preparation, dose, population, and measured outcome.', href: '/hubs/mushroom-nutrition-evidence/', link: 'Open the nutrition evidence hub' },
    { label: 'Medical limit', title: 'Educational, not medical advice', text: 'Do not delay diagnosis or replace prescribed care with mushroom foods or supplements.', href: '/editorial-policy/', link: 'Read the editorial policy' },
  ],
  growing: [
    { label: 'Growing method', title: 'Start with authenticated culture', text: 'Use supplier-identified spawn or blocks and record substrate, stage, temperature, humidity, and visible changes.', href: '/hubs/beginner-mushroom-growing/', link: 'Open the beginner growing hub' },
    { label: 'Food safety', title: 'Discard suspect batches', text: 'Unusual colors, slime, insects, or abnormal odor should be treated as a safety concern, not a climate tweak.', href: '/growing/mushroom-contamination-guide/', link: 'Review contamination guidance' },
  ],
  recipes: [
    { label: 'Food source', title: 'Cook identified edible mushrooms', text: 'Recipes assume mushrooms sold as food by a reputable supplier, not foraged specimens needing identification.', href: '/hubs/easy-mushroom-recipes/', link: 'Open the recipe hub' },
    { label: 'Kitchen safety', title: 'Handle leftovers promptly', text: 'Cool leftovers in shallow containers, refrigerate promptly, and discard food held unsafely or showing spoilage.', href: '/health/cooked-vs-raw-mushrooms/', link: 'Review preparation safety' },
  ],
};

const articleSchema: Record<string, unknown> = {
  '@type': 'Article', '@id': `${canonical}#article`, headline: title, description,
  author: { '@type': 'Organization', name: author, url: 'https://mushroomscope.com/authors/mushroomscope-editorial-team/' },
  publisher: { '@id': 'https://mushroomscope.com/#organization' },
  datePublished: publishDate.toISOString(), dateModified: (updatedDate || publishDate).toISOString(),
  mainEntityOfPage: { '@id': `${canonical}#webpage` }, articleSection: categoryName, inLanguage: 'en',
  ...(coverImage ? { image: new URL(coverImage.src, Astro.site).href } : {}),
  ...(scientificName ? { about: { '@id': `${canonical}#taxon` }, mainEntity: { '@id': `${canonical}#taxon` } } : {}),
  ...(reviewedBy ? { reviewedBy: { '@type': 'Person', name: reviewedBy } } : {}),
  ...(sources.length ? { citation: sources.map((source) => ({ '@type': 'CreativeWork', name: source.title, url: source.url })) } : {}),
};

const schema = [
  articleSchema,
  ...(scientificName ? [{
    '@type': 'Taxon', '@id': `${canonical}#taxon`, name: scientificName,
    alternateName: [...commonNames, ...synonyms], url: canonical,
    taxonRank: 'species',
    ...(taxonomicAuthority ? { author: taxonomicAuthority } : {}),
    ...(externalIds ? { identifier: Object.entries(externalIds).filter(([, value]) => value).map(([propertyID, value]) => ({ '@type': 'PropertyValue', propertyID, value })) } : {}),
    parentTaxon: taxonomy?.genus ? { '@type': 'Taxon', name: taxonomy.genus, taxonRank: 'genus' } : undefined,
  }] : []),
  { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mushroomscope.com/' },
    { '@type': 'ListItem', position: 2, name: categoryName, item: `https://mushroomscope.com/${category}/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ] },
  ...(recipe ? [{ '@type': 'Recipe', '@id': `${canonical}#recipe`, name: title, description, author: { '@type': 'Organization', name: author, url: 'https://mushroomscope.com/authors/mushroomscope-editorial-team/' }, datePublished: publishDate.toISOString(), prepTime: recipe.prepTime, cookTime: recipe.cookTime, ...(recipe.totalTime ? { totalTime: recipe.totalTime } : {}), recipeYield: recipe.recipeYield, recipeCategory: recipe.recipeCategory, ...(recipe.recipeCuisine ? { recipeCuisine: recipe.recipeCuisine } : {}), ...(keywords.length ? { keywords: keywords.join(', ') } : {}), recipeIngredient: recipe.ingredients, recipeInstructions: recipe.instructions, ...(recipe.calories ? { nutrition: { '@type': 'NutritionInformation', calories: recipe.calories } } : {}), ...(coverImage ? { image: new URL(coverImage.src, Astro.site).href } : {}), mainEntityOfPage: { '@id': `${canonical}#webpage` } }] : []),
  { '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---
<BaseLayout title={title} seoTitle={seoTitle} description={description} image={coverImage?.src} imageAlt={coverAlt || title} type="article" schema={schema}>
  <div class="shell py-8"><Breadcrumbs items={[{ label: categoryName, href: `/${category}/` }, { label: title }]} /></div>
  <article class="shell grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div>
      <header class="max-w-4xl">
        <p class="eyebrow">{categoryName}</p>
        <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-6xl">{title}</h1>
        <p class="mt-6 text-xl leading-8 text-slate-600">{description}</p>
        <p class="mt-5 text-sm text-slate-500">By <a href="/authors/mushroomscope-editorial-team/" rel="author">{author}</a> · <time datetime={publishDate.toISOString()}>{publishDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</time>{updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</time></>}{category === 'health' && reviewDate && <> · {reviewStatus === 'expert-reviewed' ? 'Expert reviewed' : 'Editorially reviewed'} <time datetime={reviewDate.toISOString()}>{reviewDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</time></>}</p>
      </header>

      {(category === 'mushrooms' || category === 'identification') && <div class="mt-8 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm leading-6 text-amber-950" role="note"><strong>Identification safety:</strong> This guide is educational. Never eat a wild mushroom unless a qualified local expert has examined the complete specimen in person.</div>}
      {category === 'health' && evidenceLevel && <section class="mt-8 rounded-2xl border border-sage-100 bg-white p-5" aria-label="Evidence and review status"><div class="flex flex-wrap items-center gap-3"><span class="rounded-full bg-sage-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-forest-800">{formatValue(evidenceLevel)} evidence</span><span class="text-sm text-slate-600">{reviewStatus === 'expert-reviewed' ? `Expert reviewed by ${reviewedBy}` : 'Editorial review only; no named clinical expert review is claimed.'}</span></div></section>}
      {updatedDate && revisionSummary && <aside class="mt-8 rounded-2xl border border-beige-300 bg-beige-50 p-5 text-sm leading-6 text-slate-700" aria-label="Revision note"><strong>What changed:</strong> {revisionSummary}</aside>}

      {trustNotes[category] && <section class="mt-8 grid gap-4 md:grid-cols-2" aria-label="How to use this guide">{trustNotes[category].map((note) => <article class="rounded-2xl border border-sage-100 bg-white p-5"><p class="eyebrow">{note.label}</p><h2 class="mt-2 font-serif text-2xl">{note.title}</h2><p class="mt-3 text-sm leading-6 text-slate-600">{note.text}</p><a href={note.href} class="mt-4 inline-block text-sm font-bold text-forest-700">{note.link} →</a></article>)}</section>}

      {coverImage && <figure class="mt-8"><Image src={coverImage} alt={coverAlt || title} widths={[480, 768, 1200, 1600]} sizes="(min-width: 1280px) 880px, (min-width: 1024px) calc(100vw - 380px), 100vw" format="webp" quality="high" loading="eager" fetchpriority="high" decoding="async" class="aspect-[3/2] w-full rounded-3xl object-cover" />{(imageCredit || imageNote) && <figcaption class="mt-3 text-sm leading-6 text-slate-500">{imageCredit && <span>{imageCredit}</span>}{imageCredit && imageNote && <span> · </span>}{imageNote && <span>{imageNote}</span>}</figcaption>}</figure>}

      {scientificName && <section class="card mt-10" aria-labelledby="quick-facts"><h2 id="quick-facts" class="font-serif text-3xl">Quick facts</h2><dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3"><div><dt class="eyebrow">Scientific name</dt><dd class="mt-1 italic">{scientificName}</dd>{taxonomicAuthority && <dd class="mt-1 text-sm text-slate-500">{taxonomicAuthority}</dd>}</div><div><dt class="eyebrow">Common names</dt><dd class="mt-1">{commonNames.join(', ')}</dd></div><div><dt class="eyebrow">Taxonomy</dt><dd class="mt-1">{taxonomy?.genus && <>{indexableGenera.has(taxonomy.genus) ? <a href={taxonPath('genus', taxonomy.genus)}>{taxonomy.genus}</a> : <span>{taxonomy.genus}</span>}{taxonomy.family ? ' · ' : ''}</>}{taxonomy?.family && (indexableFamilies.has(taxonomy.family) ? <a href={taxonPath('family', taxonomy.family)}>{taxonomy.family}</a> : <span>{taxonomy.family}</span>)}{!taxonomy?.genus && !taxonomy?.family && 'Not documented'}</dd></div><div class="sm:col-span-2"><dt class="eyebrow">Edibility context</dt><dd class="mt-1"><strong>{formatValue(edibility?.status)}:</strong> {edibility?.notes ?? 'Not documented. Do not infer safety from a category label.'}</dd></div><div><dt class="eyebrow">Spore print</dt><dd class="mt-1">{appearance?.sporePrint ?? 'Not documented'}</dd></div><div class="sm:col-span-2"><dt class="eyebrow">Toxicity context</dt><dd class="mt-1"><strong>{formatValue(toxicity?.level)}:</strong> {toxicity?.notes ?? 'Not documented. Absence of a known toxin does not confirm identity or edibility.'}</dd></div><div><dt class="eyebrow">Season</dt><dd class="mt-1">{season?.months.join(', ') || 'Varies by region'}</dd></div><div><dt class="eyebrow">Growing difficulty</dt><dd class="mt-1">{formatValue(growingDifficulty?.level)}</dd></div><div><dt class="eyebrow">Regions</dt><dd class="mt-1">{habitat?.regions.join(', ') || 'Not documented'}</dd></div>{synonyms.length > 0 && <div class="sm:col-span-2 lg:col-span-3"><dt class="eyebrow">Recorded synonyms</dt><dd class="mt-1 italic">{synonyms.join(', ')}</dd></div>}</dl><p class="mt-6 border-t border-beige-300 pt-4 text-sm leading-6 text-slate-600"><strong>Safety limit:</strong> These labels summarize documented context; they never authenticate a wild specimen. Cooking does not make a poisonous species safe.</p></section>}

      {headings.filter(({ depth }) => depth === 2).length >= 3 && <nav class="mt-8 rounded-2xl border border-beige-300 bg-beige-50 p-5" aria-label="On this page"><p class="font-bold">On this page</p><ol class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">{headings.filter(({ depth }) => depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}

      {recipe && <section class="card mt-10" aria-labelledby="recipe-details"><h2 id="recipe-details" class="font-serif text-3xl">Recipe details</h2><dl class="mt-5 grid gap-4 sm:grid-cols-3"><div><dt class="eyebrow">Prep time</dt><dd class="mt-1 font-semibold">{recipe.prepTime}</dd></div><div><dt class="eyebrow">Cook time</dt><dd class="mt-1 font-semibold">{recipe.cookTime}</dd></div><div><dt class="eyebrow">Yield</dt><dd class="mt-1 font-semibold">{recipe.recipeYield}</dd></div></dl><h3 class="mt-8 font-serif text-2xl">Ingredients</h3><ul class="mt-4 list-disc space-y-2 pl-6">{recipe.ingredients.map((ingredient) => <li>{ingredient}</li>)}</ul><h3 class="mt-8 font-serif text-2xl">Instructions</h3><ol class="mt-4 list-decimal space-y-3 pl-6">{recipe.instructions.map((instruction) => <li>{instruction}</li>)}</ol></section>}

      <div class="prose mt-10"><slot /></div>

      {sources.length > 0 && <section class="mt-14 border-t border-beige-300 pt-8" aria-labelledby="source-quality"><h2 id="source-quality" class="font-serif text-3xl">Source quality notes</h2><p class="mt-3 max-w-3xl leading-7 text-slate-600">MushroomScope cites sources that match the page scope, such as taxonomic databases, extension guidance, food-safety agencies, food-composition databases, and peer-reviewed or institutional health references. Sources support context and uncertainty; they do not turn an online page into specimen identification, medical advice, or a tested recipe record.</p></section>}

      <section id="frequently-asked-questions" class="mt-14"><h2 class="font-serif text-3xl">Frequently asked questions</h2><div class="mt-5 grid gap-3">{faq.map((item) => <details class="card"><summary class="cursor-pointer font-bold">{item.question}</summary><p class="mt-3 leading-7 text-slate-600">{item.answer}</p></details>)}</div></section>

      {related.length > 0 && <section class="mt-14 border-t border-beige-300 pt-10"><h2 class="font-serif text-3xl">Related guides</h2><div class="mt-6 grid gap-5 md:grid-cols-3">{related.map((entry) => <ArticleCard title={entry.data.title} description={entry.data.description} category={entry.data.category} href={entryPath(entry)} image={entry.data.coverImage} imageAlt={entry.data.coverAlt} analyticsEvent="related_guide_click" />)}</div></section>}
      <section class="mt-14 border-t border-beige-300 pt-8"><h2 class="font-serif text-3xl">Continue exploring</h2><p class="mt-3 text-slate-600">Browse more practical guides in <a href={`/${category}/`} class="font-semibold text-forest-700">{categoryName}</a> or visit the <a href="/mushrooms/" class="font-semibold text-forest-700">mushroom encyclopedia</a>.</p></section>
    </div>
    <aside class="space-y-6 lg:sticky lg:top-6 lg:self-start"><AdBanner placement="sidebar" /><div class="card"><p class="font-serif text-xl">Editorial transparency</p><p class="mt-3 text-sm leading-6 text-slate-600">The organizational byline describes MushroomScope’s editorial work. Named expert review is disclosed only when it has occurred. <a href="/about/">How we work</a>.</p></div></aside>
  </article>
</BaseLayout>
