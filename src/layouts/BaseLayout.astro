---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title: string; seoTitle?: string; description: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; noindex?: boolean; schema?: Record<string, unknown> | Record<string, unknown>[] }
const { title, seoTitle, description, image, imageAlt, type = 'website', noindex = false, schema } = Astro.props;
const siteName = 'MushroomScope';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nonSearchLandingPaths = new Set(['/contact/', '/disclaimer/', '/privacy-policy/', '/rss/', '/sitemap/', '/terms/']);
const effectiveNoindex = noindex || nonSearchLandingPaths.has(Astro.url.pathname);
const pathTitleOverrides: Record<string, string> = {
  '/about/': 'About MushroomScope: Mission & Editorial Standards',
  '/blog/': 'Mushroom Guides, Research & Recipes | MushroomScope',
  '/contact/': 'Contact MushroomScope: Corrections & Editorial Queries',
  '/editorial-policy/': 'MushroomScope Editorial and Fact-Checking Policy',
  '/growing/': 'Mushroom Growing Guides & Cultivation Database',
  '/health/': 'Mushroom Health Evidence & Nutrition Guides',
  '/mushrooms/': 'Mushroom Species Encyclopedia & Taxonomy Database',
  '/privacy-policy/': 'MushroomScope Privacy and Data Use Policy',
  '/recipes/': 'Mushroom Recipes, Cooking Guides & Techniques',
  '/rss/': 'MushroomScope RSS Feed: New and Updated Guides',
  '/sitemap/': 'MushroomScope HTML Sitemap & Knowledge Index',
  '/terms/': 'MushroomScope Terms of Use & Content Conditions',
};
const titleCandidate = seoTitle?.trim() || pathTitleOverrides[Astro.url.pathname] || title;
const brandedTitle = titleCandidate.includes(siteName) ? titleCandidate : `${titleCandidate} | ${siteName}`;
const pageTitle = brandedTitle.length <= 60 ? brandedTitle : titleCandidate;
const imageUrl = image ? new URL(image, Astro.site) : undefined;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const adsenseId = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID;
const organizationId = 'https://mushroomscope.com/#organization';
const websiteId = 'https://mushroomscope.com/#website';
const graph = [
  { '@type': 'Organization', '@id': organizationId, name: 'MushroomScope', url: 'https://mushroomscope.com/', logo: { '@type': 'ImageObject', url: 'https://mushroomscope.com/favicon.svg', width: 512, height: 512 }, email: 'hello@mushroomscope.com', sameAs: ['https://github.com/xuniyoucai-sudo/mushroomscope'] },
  { '@type': 'WebSite', '@id': websiteId, name: 'MushroomScope', url: 'https://mushroomscope.com/', description: 'Explore the fascinating world of mushrooms.', publisher: { '@id': organizationId }, inLanguage: 'en', potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: 'https://mushroomscope.com/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
  { '@type': 'WebPage', '@id': `${canonical.href}#webpage`, url: canonical.href, name: pageTitle, description, isPartOf: { '@id': websiteId }, about: { '@id': organizationId }, inLanguage: 'en' },
  ...(Array.isArray(schema) ? schema : schema ? [schema] : [])
];
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="MushroomScope RSS" href="/rss.xml" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta name="baidu-site-verification" content="codeva-2aqKHOWOiO" />
    <meta property="og:type" content={type} /><meta property="og:site_name" content={siteName} /><meta property="og:locale" content="en_US" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />{imageUrl && <meta property="og:image" content={imageUrl} />}{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />{imageUrl && <meta name="twitter:image" content={imageUrl} />}{imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script is:inline type="application/ld+json" set:html={structuredData} />
    {adsenseId && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>}
    {/* Google Analytics 4 is intentionally disabled. Do not restore the tag without updating the privacy policy and consent experience first. */}
  </head>
  <body><a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-3">Skip to content</a><Header /><main id="main"><slot /></main><Footer /></body>
</html>
