---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentPreferences from '../components/ConsentPreferences.astro';
import '../styles/global.css';

interface Props { title: string; description: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; noindex?: boolean; schema?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description, image, imageAlt, type = 'website', noindex = false, schema } = Astro.props;
const siteName = 'MushroomScope';
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const gaId = import.meta.env.PUBLIC_GA_ID;
const adsenseId = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID;
const organizationId = 'https://mushroomscope.com/#organization';
const websiteId = 'https://mushroomscope.com/#website';
const graph = [
  { '@type': 'Organization', '@id': organizationId, name: 'MushroomScope', url: 'https://mushroomscope.com/', logo: { '@type': 'ImageObject', url: 'https://mushroomscope.com/favicon.svg', width: 512, height: 512 }, email: 'hello@mushroomscope.com' },
  { '@type': 'WebSite', '@id': websiteId, name: 'MushroomScope', url: 'https://mushroomscope.com/', description: 'Explore the fascinating world of mushrooms.', publisher: { '@id': organizationId }, inLanguage: 'en', potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: 'https://mushroomscope.com/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
  { '@type': 'WebPage', '@id': `${canonical.href}#webpage`, url: canonical.href, name: pageTitle, description, isPartOf: { '@id': websiteId }, about: { '@id': organizationId }, inLanguage: 'en' },
  ...(Array.isArray(schema) ? schema : schema ? [schema] : [])
];
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="MushroomScope RSS" href="/rss.xml" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta property="og:type" content={type} /><meta property="og:site_name" content={siteName} /><meta property="og:locale" content="en_US" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />{imageUrl && <meta property="og:image" content={imageUrl} />}{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />{imageUrl && <meta name="twitter:image" content={imageUrl} />}{imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script is:inline type="application/ld+json" set:html={structuredData} />
    {adsenseId && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
      window.gtag('set', 'ads_data_redaction', true);
      window.mushroomscopeLoadAnalytics = window.mushroomscopeLoadAnalytics || function(){
        if (window.__mushroomscopeAnalyticsLoaded) return;
        window.__mushroomscopeAnalyticsLoaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
        document.head.appendChild(script);
        window.gtag('js', new Date());
        window.gtag('config', gaId, { page_location: `${window.location.origin}${window.location.pathname}`, allow_google_signals: false, allow_ad_personalization_signals: false });
        window.dispatchEvent(new CustomEvent('mushroomscope:analytics-ready'));
      };
      window.mushroomscopeTrack = window.mushroomscopeTrack || function(name, parameters){ if (window.__mushroomscopeAnalyticsLoaded) window.gtag('event', name, parameters); };
      try {
        const choice = JSON.parse(localStorage.getItem('mushroomscope-consent-v1') || 'null');
        if (choice?.analytics) {
          window.gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: choice.advertising ? 'granted' : 'denied', ad_user_data: choice.advertising ? 'granted' : 'denied', ad_personalization: choice.advertising ? 'granted' : 'denied' });
          window.mushroomscopeLoadAnalytics();
        }
      } catch {}
    </script>}
  </head>
  <body><a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-3">Skip to content</a><Header /><main id="main"><slot /></main><Footer />{gaId && <ConsentPreferences gaId={gaId} />}</body>
</html>
