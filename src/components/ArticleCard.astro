---
interface Props { title: string; description: string; href: string; category: string; date?: Date }
const { title, description, href, category, date } = Astro.props;
---
<a href={href} class="article-card-link group block h-full no-underline" aria-label={`Read ${title}`}>
  <article class="card flex h-full flex-col transition duration-200 group-hover:-translate-y-1 group-hover:border-forest-700/40 group-hover:shadow-[0_18px_48px_rgba(19,38,29,0.12)]">
    <p class="eyebrow">{category}</p>
    <h3 class="mt-3 font-serif text-2xl transition group-hover:text-forest-700">{title}</h3>
    <p class="mt-3 flex-1 leading-7 text-slate-600">{description}</p>
    {date && <time class="mt-5 text-sm text-slate-500" datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
  </article>
</a>
