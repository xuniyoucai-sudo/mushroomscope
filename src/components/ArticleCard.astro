---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; description: string; href: string; category: string; date?: Date; image?: ImageMetadata; imageAlt?: string; meta?: string; analyticsEvent?: string }
const { title, description, href, category, date, image, imageAlt, meta, analyticsEvent } = Astro.props;
---
<a href={href} class="article-card-link group block h-full no-underline" aria-label={`Read ${title}`} data-analytics-event={analyticsEvent} data-analytics-category={category}>
  <article class="card flex h-full flex-col overflow-hidden p-0 transition duration-200 group-hover:-translate-y-1 group-hover:border-forest-700/40 group-hover:shadow-[0_18px_48px_rgba(19,38,29,0.12)]">
    {image && <Image src={image} alt={imageAlt || ''} widths={[360, 640, 900]} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw" format="webp" quality="mid" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover transition duration-300 group-hover:scale-[1.02]" />}
    <div class="flex flex-1 flex-col p-6">
      <p class="eyebrow">{category}</p>
      <h3 class="mt-3 font-serif text-2xl transition group-hover:text-forest-700">{title}</h3>
      <p class="mt-3 flex-1 leading-7 text-slate-600">{description}</p>
      {meta && <p class="mt-5 border-t border-beige-300/70 pt-4 text-sm font-medium text-forest-700">{meta}</p>}
      {date && <time class="mt-4 text-sm text-slate-500" datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
    </div>
  </article>
</a>
