---
const links = [
  ['Mushrooms', '/mushrooms/'], ['Identify', '/identification/'], ['Growing', '/growing/'],
  ['Health', '/health/'], ['Recipes', '/recipes/'], ['Glossary', '/glossary/'], ['Search', '/search/']
];
---
<header class="border-b border-beige-300/70 bg-beige-50/95">
  <div class="shell flex min-h-18 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 text-xl font-bold no-underline" aria-label="MushroomScope home">
      <span class="grid size-10 place-items-center rounded-full bg-forest-800 text-xl text-white" aria-hidden="true">◒</span>
      MushroomScope
    </a>
    <nav aria-label="Main navigation" class="hidden items-center gap-6 lg:flex">
      {links.map(([label, href]) => <a href={href} class="text-sm font-semibold no-underline hover:text-forest-700">{label}</a>)}
    </nav>
    <details class="relative lg:hidden">
      <summary class="cursor-pointer rounded-full border border-beige-300 px-4 py-2 font-semibold">Menu</summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 z-20 mt-2 grid min-w-48 gap-1 rounded-2xl border border-beige-300 bg-white p-3 shadow-xl">
        {links.map(([label, href]) => <a href={href} class="rounded-lg px-3 py-2 font-semibold no-underline hover:bg-sage-100">{label}</a>)}
      </nav>
    </details>
  </div>
</header>
