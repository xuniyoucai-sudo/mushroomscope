---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-600">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href="/" class="hover:text-forest-700">Home</a></li>
    {items.map((item, i) => <li class="flex items-center gap-2"><span aria-hidden="true">/</span>{item.href && i < items.length - 1 ? <a href={item.href} class="hover:text-forest-700">{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
