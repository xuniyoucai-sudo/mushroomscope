---
interface Props { gaId: string }
const { gaId } = Astro.props;
---

<section id="consent-banner" class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-3xl rounded-3xl border border-beige-300 bg-white p-5 shadow-2xl sm:p-6" aria-labelledby="consent-title" hidden>
  <h2 id="consent-title" class="font-serif text-2xl">Your privacy choices</h2>
  <p class="mt-3 text-sm leading-6 text-slate-600">MushroomScope uses optional analytics to understand which guides help readers. Analytics stays off unless you choose to allow it. We do not send your search words to Google Analytics.</p>
  <div class="mt-5 flex flex-wrap gap-3">
    <button id="consent-accept" class="button" type="button">Accept all</button>
    <button id="consent-reject" class="button-secondary" type="button">Reject all</button>
    <button id="consent-manage" class="min-h-11 px-3 font-semibold text-forest-700 underline" type="button">Manage preferences</button>
  </div>
</section>

<dialog id="consent-dialog" class="m-auto w-[min(92vw,42rem)] rounded-3xl border border-beige-300 bg-white p-0 text-forest-950 shadow-2xl backdrop:bg-forest-950/60" aria-labelledby="preferences-title">
  <form id="consent-form" method="dialog" class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-5">
      <div><p class="eyebrow">Privacy settings</p><h2 id="preferences-title" class="mt-2 font-serif text-3xl">Manage preferences</h2></div>
      <button id="consent-close" class="grid size-11 shrink-0 place-items-center rounded-full border border-beige-300 text-xl" type="button" aria-label="Close privacy settings">×</button>
    </div>
    <p class="mt-4 leading-7 text-slate-600">Necessary storage keeps your privacy choice and is always active. Optional categories remain off until you enable them.</p>
    <div class="mt-6 grid gap-4">
      <div class="rounded-2xl border border-beige-300 p-4"><div class="flex items-center justify-between gap-4"><div><h3 class="font-bold">Necessary</h3><p class="mt-1 text-sm leading-6 text-slate-600">Stores only your privacy preference.</p></div><span class="text-sm font-bold text-forest-700">Always on</span></div></div>
      <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl border border-beige-300 p-4" for="consent-analytics"><span><strong class="block">Analytics</strong><span class="mt-1 block text-sm leading-6 text-slate-600">Measures page views, anonymous search activity and related-guide clicks. Search words are never sent.</span></span><input id="consent-analytics" class="mt-1 size-5 accent-forest-700" type="checkbox" /></label>
      <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl border border-beige-300 p-4" for="consent-advertising"><span><strong class="block">Advertising</strong><span class="mt-1 block text-sm leading-6 text-slate-600">Allows advertising storage and personalization signals if advertising is enabled in the future. No Google Ads configuration is added by this setting.</span></span><input id="consent-advertising" class="mt-1 size-5 accent-forest-700" type="checkbox" /></label>
    </div>
    <div class="mt-7 flex flex-wrap gap-3"><button class="button" value="save" type="submit">Save choices</button><a class="button-secondary" href="/privacy-policy/">Privacy policy</a></div>
  </form>
</dialog>

<script is:inline define:vars={{ gaId }}>
  const consentKey = 'mushroomscope-consent-v1';
  const banner = document.querySelector('#consent-banner');
  const dialog = document.querySelector('#consent-dialog');
  const form = document.querySelector('#consent-form');
  const analyticsInput = document.querySelector('#consent-analytics');
  const advertisingInput = document.querySelector('#consent-advertising');
  const readChoice = () => {
    try { return JSON.parse(localStorage.getItem(consentKey) || 'null'); } catch { return null; }
  };
  const openPreferences = () => {
    const choice = readChoice();
    analyticsInput.checked = Boolean(choice?.analytics);
    advertisingInput.checked = Boolean(choice?.advertising);
    if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', '');
  };
  const closePreferences = () => { if (typeof dialog.close === 'function') dialog.close(); else dialog.removeAttribute('open'); };
  const clearAnalyticsCookies = () => {
    document.cookie.split(';').map((item) => item.split('=')[0].trim()).filter((name) => name === '_ga' || name.startsWith('_ga_')).forEach((name) => {
      document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
      document.cookie = `${name}=; Max-Age=0; path=/; domain=.mushroomscope.com; SameSite=Lax`;
    });
  };
  const saveChoice = (analytics, advertising) => {
    const previous = readChoice();
    const choice = { version: 1, analytics, advertising, updatedAt: new Date().toISOString() };
    localStorage.setItem(consentKey, JSON.stringify(choice));
    window.gtag?.('consent', 'update', {
      analytics_storage: analytics ? 'granted' : 'denied',
      ad_storage: advertising ? 'granted' : 'denied',
      ad_user_data: advertising ? 'granted' : 'denied',
      ad_personalization: advertising ? 'granted' : 'denied',
    });
    if (analytics) window.mushroomscopeLoadAnalytics?.();
    if (!analytics) clearAnalyticsCookies();
    banner.hidden = true;
    closePreferences();
    if (previous?.analytics && !analytics) window.location.reload();
  };

  document.querySelector('#consent-accept')?.addEventListener('click', () => saveChoice(true, true));
  document.querySelector('#consent-reject')?.addEventListener('click', () => saveChoice(false, false));
  document.querySelector('#consent-manage')?.addEventListener('click', openPreferences);
  document.querySelector('#privacy-settings-button')?.addEventListener('click', openPreferences);
  document.querySelector('#consent-close')?.addEventListener('click', closePreferences);
  form?.addEventListener('submit', (event) => { event.preventDefault(); saveChoice(analyticsInput.checked, advertisingInput.checked); });
  if (!readChoice()) banner.hidden = false;

  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('[data-analytics-event]') : null;
    if (!(link instanceof HTMLAnchorElement)) return;
    window.mushroomscopeTrack?.(link.dataset.analyticsEvent || 'content_click', {
      content_category: link.dataset.analyticsCategory || 'guide',
      destination_path: new URL(link.href).pathname,
    });
  });
</script>
